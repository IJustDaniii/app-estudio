generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskPlanningMode {
  FIXED_DEADLINE
  FLEXIBLE_STUDY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum MissionMetric {
  STUDY_MINUTES
  TASKS_COMPLETED
}

enum MaterialType {
  NOTES
  EXERCISES
  EXAM
  SOLUTIONS
  THEORY
  RUBRIC
  PROJECT
  OTHER
}

enum MaterialProcessingStatus {
  PENDING
  PROCESSED
  ERROR
}

enum AIProviderKind {
  OLLAMA
}

enum AIMessageRole {
  USER
  ASSISTANT
}

enum AIMessageStatus {
  PENDING
  COMPLETE
  ERROR
}

enum AIActionStatus {
  PENDING
  EXECUTING
  EXECUTED
  CANCELLED
  EXPIRED
  FAILED
}

enum PetRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum UserPetSource {
  OFFICIAL
  CUSTOM
}

enum UserPetStatus {
  PRESENT
  TEMPORARILY_AWAY
}

enum UserEggStatus {
  AVAILABLE
  INCUBATING
  HATCHED
}

enum CosmeticType {
  FRAME
  BADGE
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  image             String?
  emailVerified     DateTime?
  timezone          String             @default("Europe/Madrid")
  xp                Int                @default(0)
  coins             Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  subjects          Subject[]
  timetable         TimetableEntry[]
  tasks             Task[]
  bosses            Boss[]
  grades            Grade[]
  goals             Goal[]
  studySessions     StudySession[]
  missions          Mission[]
  materials         Material[]
  topics            Topic[]
  aiSettings        AISettings?
  aiChats           AIChat[]
  aiMessages        AIMessage[]
  aiActionProposals AIActionProposal[]
  aiAuditLogs       AIAuditLog[]
  inventory         Inventory?
  pets              UserPet[]
  eggs              UserEgg[]
  shopPurchases     PetShopPurchase[]
  cosmeticPurchases CosmeticPurchase[]
  fragments         SpeciesFragment[]
  cosmetics         UserCosmetic[]
}

model AISettings {
  userId                       String         @id
  user                         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider                     AIProviderKind @default(OLLAMA)
  ollamaUrl                    String         @default("http://127.0.0.1:11434")
  model                        String         @default("qwen3.5:9b")
  isAIEnabled                  Boolean        @default(true)
  isAcademicContextEnabled     Boolean        @default(true)
  canReadGrades                Boolean        @default(true)
  canReadTasksAndBosses        Boolean        @default(true)
  canReadSessionsAndStatistics Boolean        @default(true)
  canReadSchedule              Boolean        @default(true)
  canReadMaterials             Boolean        @default(true)
  canReadGamification          Boolean        @default(true)
  contextLimit                 Int            @default(12000)
  maxItemsPerCategory          Int            @default(20)
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt
}

model AIChat {
  id              String             @id @default(cuid())
  title           String             @default("Nuevo chat")
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        AIMessage[]
  actionProposals AIActionProposal[]
  auditLogs       AIAuditLog[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([id, userId])
  @@index([userId, updatedAt])
}

model AIMessage {
  id              String          @id @default(cuid())
  role            AIMessageRole
  content         String
  status          AIMessageStatus @default(COMPLETE)
  model           String?
  errorCode       String?
  contextSnapshot Json?
  requestId       String?
  inputTokens     Int?
  outputTokens    Int?
  chatId          String
  userId          String
  chat            AIChat          @relation(fields: [chatId, userId], references: [id, userId], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([userId, requestId])
  @@index([userId, chatId, createdAt])
}

model AIActionProposal {
  id                    String         @id @default(cuid())
  action                String
  arguments             Json
  argumentHash          String
  summary               String
  status                AIActionStatus @default(PENDING)
  confirmationTokenHash String         @unique
  requestId             String?
  result                Json?
  expiresAt             DateTime
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId                String?
  chat                  AIChat?        @relation(fields: [chatId], references: [id], onDelete: SetNull)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([userId, requestId])
  @@index([userId, status, expiresAt])
}

model AIAuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  outcome    String
  summary    String
  metadata   Json?
  proposalId String?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId     String?
  chat       AIChat?  @relation(fields: [chatId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, proposalId])
}

model Subject {
  id            String           @id @default(cuid())
  name          String
  color         String           @default("slate")
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  timetable     TimetableEntry[]
  tasks         Task[]
  bosses        Boss[]
  grades        Grade[]
  studySessions StudySession[]
  topics        Topic[]
  materials     Material[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model TimetableEntry {
  id        String  @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

model Task {
  id               String           @id @default(cuid())
  title            String
  planningMode     TaskPlanningMode
  type             String
  priority         Priority
  difficulty       Int
  dueDate          DateTime?
  estimatedMinutes Int
  status           TaskStatus       @default(PENDING)
  notes            String?
  completedAt      DateTime?
  subjectId        String?
  subject          Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySessions    StudySession[]
  materials        Material[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId, status, dueDate])
}

model Boss {
  id            String     @id @default(cuid())
  title         String
  date          DateTime
  topics        String[]
  difficulty    Int
  preparation   Int        @default(0)
  targetGrade   Float?
  expectedGrade Float?
  actualGrade   Float?
  subjectId     String
  subject       Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  materials     Material[]

  @@index([userId, date])
}

model Grade {
  id        String   @id @default(cuid())
  label     String
  value     Float
  date      DateTime @default(now())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Goal {
  id         String    @id @default(cuid())
  title      String
  targetDate DateTime?
  progress   Int       @default(0)
  isComplete Boolean   @default(false)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, isComplete])
}

model StudySession {
  id             String   @id @default(cuid())
  requestId      String?
  startedAt      DateTime
  endedAt        DateTime
  plannedMinutes Int
  actualMinutes  Int
  subjectId      String?
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  taskId         String?
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([userId, requestId])
  @@index([userId, startedAt])
}

model Mission {
  id          String        @id @default(cuid())
  date        DateTime      @db.Date
  title       String
  metric      MissionMetric
  target      Int
  progress    Int           @default(0)
  isComplete  Boolean       @default(false)
  rewardXp    Int
  rewardCoins Int
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, metric])
  @@index([userId, date])
}

model Topic {
  id        String     @id @default(cuid())
  name      String
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials Material[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([subjectId, name])
  @@index([userId, subjectId])
}

model Material {
  id               String                   @id @default(cuid())
  name             String
  originalName     String
  mimeType         String
  size             Int
  sha256           String
  storageKey       String                   @unique
  type             MaterialType             @default(OTHER)
  description      String?
  isFavorite       Boolean                  @default(false)
  processingStatus MaterialProcessingStatus @default(PENDING)
  isCompletedExam  Boolean                  @default(false)
  userId           String
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject?                 @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId          String?
  topic            Topic?                   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  taskId           String?
  task             Task?                    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  bossId           String?
  boss             Boss?                    @relation(fields: [bossId], references: [id], onDelete: SetNull)
  uploadedAt       DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([userId, sha256])
  @@index([userId, uploadedAt])
  @@index([userId, subjectId])
  @@index([userId, type])
  @@index([userId, isFavorite])
}

model Inventory {
  id        String            @id @default(cuid())
  userId    String            @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  eggs      UserEgg[]
  fragments SpeciesFragment[]
  cosmetics UserCosmetic[]
  purchases PetShopPurchase[]
  cosmeticPurchases CosmeticPurchase[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model PetSpecies {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String
  rarity      PetRarity
  imagePath   String
  isOfficial  Boolean           @default(true)
  pets        UserPet[]
  evolutions  PetEvolution[]
  fragments   SpeciesFragment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([isOfficial, rarity])
}

model PetEvolution {
  id        String     @id @default(cuid())
  speciesId String
  species   PetSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  level     Int
  name      String
  imagePath String
  pets      UserPet[]
  createdAt DateTime   @default(now())

  @@unique([speciesId, level])
  @@index([speciesId, level])
}

model EggType {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  name          String
  description   String
  priceCoins    Int
  incubationXp  Int
  imagePath     String
  isAvailable   Boolean                @default(true)
  probabilities EggRarityProbability[]
  eggs          UserEgg[]
  purchases     PetShopPurchase[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

model EggRarityProbability {
  id        String    @id @default(cuid())
  eggTypeId String
  eggType   EggType   @relation(fields: [eggTypeId], references: [id], onDelete: Cascade)
  rarity    PetRarity
  weight    Int

  @@unique([eggTypeId, rarity])
  @@index([eggTypeId, weight])
}

model UserEgg {
  id                   String           @id @default(cuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryId          String
  inventory            Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  eggTypeId            String
  eggType              EggType          @relation(fields: [eggTypeId], references: [id], onDelete: Restrict)
  status               UserEggStatus    @default(AVAILABLE)
  incubationXp         Int              @default(0)
  incubationRequiredXp Int
  purchasedAt          DateTime         @default(now())
  incubationStartedAt  DateTime?
  hatchedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  purchase             PetShopPurchase?

  @@index([userId, status])
  @@index([inventoryId, status])
}

model PetShopPurchase {
  id          String    @id @default(cuid())
  requestId   String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  eggTypeId   String
  eggType     EggType   @relation(fields: [eggTypeId], references: [id], onDelete: Restrict)
  userEggId   String    @unique
  userEgg     UserEgg   @relation(fields: [userEggId], references: [id], onDelete: Restrict)
  priceCoins  Int
  createdAt   DateTime  @default(now())

  @@unique([userId, requestId])
  @@index([userId, createdAt])
}

model UserPet {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source               UserPetSource
  name                 String
  speciesId            String?
  species              PetSpecies?   @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  rarity               PetRarity?
  level                Int           @default(1)
  xp                   Int           @default(0)
  happiness            Int           @default(80)
  status               UserPetStatus @default(PRESENT)
  evolutionId          String?
  evolution            PetEvolution? @relation(fields: [evolutionId], references: [id], onDelete: SetNull)
  customImagePath      String?
  customImageMimeType  String?
  isActive             Boolean       @default(false)
  obtainedAt           DateTime      @default(now())
  lastAcademicActivity DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId, source])
  @@index([userId, isActive])
  @@index([speciesId])
}

model SpeciesFragment {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryId String
  inventory   Inventory  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  speciesId   String
  species     PetSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  quantity    Int        @default(0)
  updatedAt   DateTime   @updatedAt

  @@unique([inventoryId, speciesId])
  @@index([userId, speciesId])
}

model Cosmetic {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String
  type        CosmeticType
  priceCoins  Int
  imagePath   String
  isAvailable Boolean        @default(true)
  owners      UserCosmetic[]
  purchases   CosmeticPurchase[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model UserCosmetic {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  cosmeticId  String
  cosmetic    Cosmetic  @relation(fields: [cosmeticId], references: [id], onDelete: Restrict)
  quantity    Int       @default(1)
  acquiredAt  DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([inventoryId, cosmeticId])
  @@index([userId, cosmeticId])
}

model CosmeticPurchase {
  id          String    @id @default(cuid())
  requestId   String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  cosmeticId  String
  cosmetic    Cosmetic  @relation(fields: [cosmeticId], references: [id], onDelete: Restrict)
  priceCoins  Int
  createdAt   DateTime  @default(now())

  @@unique([userId, requestId])
  @@index([userId, createdAt])
}
