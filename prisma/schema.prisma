generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskPlanningMode {
  FIXED_DEADLINE
  FLEXIBLE_STUDY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum MissionMetric {
  STUDY_MINUTES
  TASKS_COMPLETED
}

enum MaterialType {
  NOTES
  EXERCISES
  EXAM
  SOLUTIONS
  THEORY
  RUBRIC
  PROJECT
  OTHER
}

enum MaterialProcessingStatus {
  PENDING
  PROCESSED
  ERROR
}

enum AIProviderKind {
  OLLAMA
}

enum AIMessageRole {
  USER
  ASSISTANT
}

enum AIMessageStatus {
  PENDING
  COMPLETE
  ERROR
}

model User {
  id            String           @id @default(cuid())
  name          String
  email         String           @unique
  passwordHash  String
  image         String?
  emailVerified DateTime?
  timezone      String           @default("Europe/Madrid")
  xp            Int              @default(0)
  coins         Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  subjects      Subject[]
  timetable     TimetableEntry[]
  tasks         Task[]
  bosses        Boss[]
  grades        Grade[]
  goals         Goal[]
  studySessions StudySession[]
  missions      Mission[]
  materials     Material[]
  topics        Topic[]
  aiSettings    AISettings?
  aiChats       AIChat[]
  aiMessages    AIMessage[]
}

model AISettings {
  userId                   String         @id
  user                     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider                 AIProviderKind @default(OLLAMA)
  ollamaUrl                String         @default("http://127.0.0.1:11434")
  model                    String         @default("qwen3.5:9b")
  isAIEnabled              Boolean        @default(true)
  isAcademicContextEnabled Boolean        @default(true)
  canReadGrades            Boolean        @default(true)
  canReadTasksAndBosses    Boolean        @default(true)
  canReadSessionsAndStatistics Boolean    @default(true)
  canReadSchedule          Boolean        @default(true)
  canReadMaterials         Boolean        @default(true)
  canReadGamification      Boolean        @default(true)
  contextLimit             Int            @default(12000)
  maxItemsPerCategory      Int            @default(20)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
}

model AIChat {
  id        String      @id @default(cuid())
  title     String      @default("Nuevo chat")
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([id, userId])
  @@index([userId, updatedAt])
}

model AIMessage {
  id              String          @id @default(cuid())
  role            AIMessageRole
  content         String
  status          AIMessageStatus @default(COMPLETE)
  model           String?
  errorCode       String?
  contextSnapshot Json?
  inputTokens     Int?
  outputTokens    Int?
  chatId          String
  userId          String
  chat            AIChat          @relation(fields: [chatId, userId], references: [id, userId], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, chatId, createdAt])
}

model Subject {
  id            String           @id @default(cuid())
  name          String
  color         String           @default("slate")
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  timetable     TimetableEntry[]
  tasks         Task[]
  bosses        Boss[]
  grades        Grade[]
  studySessions StudySession[]
  topics        Topic[]
  materials     Material[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model TimetableEntry {
  id        String  @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

model Task {
  id               String           @id @default(cuid())
  title            String
  planningMode     TaskPlanningMode
  type             String
  priority         Priority
  difficulty       Int
  dueDate          DateTime?
  estimatedMinutes Int
  status           TaskStatus       @default(PENDING)
  notes            String?
  completedAt      DateTime?
  subjectId        String?
  subject          Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySessions    StudySession[]
  materials        Material[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId, status, dueDate])
}

model Boss {
  id            String     @id @default(cuid())
  title         String
  date          DateTime
  topics        String[]
  difficulty    Int
  preparation   Int        @default(0)
  targetGrade   Float?
  expectedGrade Float?
  actualGrade   Float?
  subjectId     String
  subject       Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  materials     Material[]

  @@index([userId, date])
}

model Grade {
  id        String   @id @default(cuid())
  label     String
  value     Float
  date      DateTime @default(now())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Goal {
  id         String    @id @default(cuid())
  title      String
  targetDate DateTime?
  progress   Int       @default(0)
  isComplete Boolean   @default(false)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, isComplete])
}

model StudySession {
  id             String   @id @default(cuid())
  startedAt      DateTime
  endedAt        DateTime
  plannedMinutes Int
  actualMinutes  Int
  subjectId      String?
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  taskId         String?
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([userId, startedAt])
}

model Mission {
  id          String        @id @default(cuid())
  date        DateTime      @db.Date
  title       String
  metric      MissionMetric
  target      Int
  progress    Int           @default(0)
  isComplete  Boolean       @default(false)
  rewardXp    Int
  rewardCoins Int
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, metric])
  @@index([userId, date])
}

model Topic {
  id        String     @id @default(cuid())
  name      String
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials Material[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([subjectId, name])
  @@index([userId, subjectId])
}

model Material {
  id               String                   @id @default(cuid())
  name             String
  originalName     String
  mimeType         String
  size             Int
  sha256           String
  storageKey       String                   @unique
  type             MaterialType             @default(OTHER)
  description      String?
  isFavorite       Boolean                  @default(false)
  processingStatus MaterialProcessingStatus @default(PENDING)
  isCompletedExam  Boolean                  @default(false)
  userId           String
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject?                 @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId          String?
  topic            Topic?                   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  taskId           String?
  task             Task?                    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  bossId           String?
  boss             Boss?                    @relation(fields: [bossId], references: [id], onDelete: SetNull)
  uploadedAt       DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([userId, sha256])
  @@index([userId, uploadedAt])
  @@index([userId, subjectId])
  @@index([userId, type])
  @@index([userId, isFavorite])
}
